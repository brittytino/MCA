<!-- views/displayAll.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>All Day Scholar Students</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <h1>All Day Scholar Students</h1>

  <% if (students.length === 0) { %>
      <p>No day scholar students found.</p>
  <% } else { %>
      <table border="1" cellpadding="10">
        <tr>
          <th>Roll Number</th>
          <th>Name</th>
          <th>Skills</th>
        </tr>

        <% students.forEach(student => { %>
          <tr>
            <td><%= student.rollnumber %></td>
            <td><%= student.name %></td>
            <td><%= student.skills.join(", ") %></td>
          </tr>
        <% }) %>
      </table>
  <% } %>

  <br>
  <a href="/">Back Home</a>

</body>
</html>
